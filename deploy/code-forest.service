# =============================================================================
# Code Forest — hardened systemd unit
# Install to /etc/systemd/system/code-forest.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now code-forest
# =============================================================================
[Unit]
Description=Code Forest backend (GitHub 3D visualizer API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binary location — adjust to your deploy path.
WorkingDirectory=/opt/code-forest
ExecStart=/opt/code-forest/code-forest-backend
EnvironmentFile=/etc/code-forest.env
Restart=on-failure
RestartSec=2s

# --- Sandboxing / hardening ---
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Only needs outbound TCP to api.github.com and the local listener.
RestrictAddressFamilies=AF_INET AF_INET6
CapabilityBoundingSet=

# --- Resource limits ---
LimitNOFILE=8192
MemoryMax=256M
TasksMax=256

[Install]
WantedBy=multi-user.target
