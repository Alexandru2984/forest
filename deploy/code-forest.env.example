# Code Forest backend configuration.
# Copy to /etc/code-forest.env (chmod 600 — it may hold a token) and edit.
# All values are optional; the defaults shown match the built-in fallbacks.

# TCP port the Go service listens on (always bound to 127.0.0.1).
PORT=8089

# How long a user's repo data is cached.
CACHE_TTL=10m

# Maximum number of distinct cached users (LRU-ish by expiry).
MAX_CACHE_SIZE=100

# Fetch commit history for at most this many repos per user (most recently
# pushed first). Bounds GitHub API calls and response size.
MAX_COMMIT_REPOS=60

# Per-IP request budget (token bucket, burst = 2x). Defense-in-depth on top
# of nginx's limit_req.
RATE_LIMIT_RPS=5

# Comma-separated CORS allow-list.
ALLOWED_ORIGINS=https://forest.micutu.com

# OPTIONAL server-side GitHub token. Used ONLY to raise the rate limit for
# anonymous visitors; private repos are always stripped from anonymous results.
# Leave empty to disable. Scope: a classic PAT with no scopes (public_repo not
# required for public data) or a fine-grained token with public read access.
# GITHUB_TOKEN=
